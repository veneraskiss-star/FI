{
  "name": "project-hub",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/run.ts",
    "start": "tsx server/run.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "npm run build:desktop && electron .",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "package:mac": "npm run build:desktop && node scripts/package-mac.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.11.15",
    "esbuild": "0.25.12",
    "jose": "^6.2.12",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "main": "desktop-build/main.cjs",
  "engines": {
    "node": ">=24.15.0"
  }
}
